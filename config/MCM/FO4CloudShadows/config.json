{
  "modName": "FO4CloudShadows",
  "displayName": "Cloud Shadows",
  "minMcmVersion": 1,
  "content": [
    {
      "id": "bEnabled:CloudShadows",
      "type": "switcher",
      "text": "Enable cloud shadows",
      "help": "Enables shadows from moving clouds outdoors.",
      "valueOptions": { "sourceType": "ModSettingBool" }
    },
    {
      "id": "fOpacity:CloudShadows",
      "type": "slider",
      "text": "Shadow opacity",
      "help": "Controls how strongly clouds dim direct sunlight.",
      "valueOptions": { "sourceType": "ModSettingFloat", "min": 0.0, "max": 4.0, "step": 0.05 }
    },
    {
      "id": "bHotkeys:CloudShadows",
      "type": "switcher",
      "text": "Development Menu",
      "help": "Enables diagnostic options and the desktop F7, F8, F10, and F11 hotkeys.",
      "groupControl": 1,
      "valueOptions": { "sourceType": "ModSettingBool" }
    },
    {
      "id": "iDebugView:CloudShadows",
      "type": "dropdown",
      "text": "Debug view",
      "help": "Displays the selected diagnostic view instead of normal cloud shadows.",
      "groupCondition": 1,
      "valueOptions": { "sourceType": "ModSettingInt", "options": [ "Off", "World checkerboard", "Raw depth", "Transmittance", "Capture analysis" ] }
    },
    {
      "id": "bIsolateCloud:CloudShadows",
      "type": "switcher",
      "text": "Isolate one cloud",
      "help": "Limits capture analysis to the cloud patch you face five seconds after enabling it.",
      "groupCondition": 1,
      "valueOptions": { "sourceType": "ModSettingBool" }
    },
    {
      "id": "fIsolationRadius:CloudShadows",
      "type": "slider",
      "text": "Isolation radius",
      "help": "Sets the angular size of the isolated cloud patch in degrees.",
      "groupCondition": 1,
      "valueOptions": { "sourceType": "ModSettingFloat", "min": 2.0, "max": 30.0, "step": 0.5 }
    }
  ]
}
