{
  "modName": "FO4CloudShadows",
  "displayName": "Cloud Shadows",
  "minMcmVersion": 1,
  "content": [
    {
      "id": "bEnabled:CloudShadows",
      "type": "switcher",
      "text": "Enable cloud shadows",
      "help": "Enables shadows from moving clouds outdoors.",
      "valueOptions": { "sourceType": "ModSettingBool" }
    },
    {
      "id": "fOpacity:CloudShadows",
      "type": "slider",
      "text": "Shadow opacity",
      "help": "Controls how strongly clouds dim direct sunlight.",
      "valueOptions": { "sourceType": "ModSettingFloat", "min": 0.0, "max": 4.0, "step": 0.05 }
    },
    {
      "id": "bWaterShadows:CloudShadows",
      "type": "switcher",
      "text": "Water shadows",
      "help": "Clouds also shade water and darken its colour.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "bNightShadows:CloudShadows",
      "type": "switcher",
      "text": "Shadows at night",
      "help": "Moonlit cloud shadows at night, at their daytime cost.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "bWeatherOpacity:CloudShadows",
      "type": "switcher",
      "text": "Weather specific cloud opacity",
      "help": "Gives each weather its own shadow opacity.",
      "groupControl": 1,
      "valueOptions": { "sourceType": "ModSettingBool" }
    },
    {
      "id": "fCurrentWeather:CloudShadows",
      "type": "slider",
