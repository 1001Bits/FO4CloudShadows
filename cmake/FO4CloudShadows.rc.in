#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FO4CloudShadows contributors\0"
            VALUE "FileDescription", "Cloud Shadows F4SE plugin\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "FO4CloudShadows\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 FO4CloudShadows contributors\0"
            VALUE "OriginalFilename", "FO4CloudShadows.dll\0"
            VALUE "ProductName", "Cloud Shadows\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
